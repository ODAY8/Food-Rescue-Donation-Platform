PORT=5000

# PostgreSQL connection string (local dev via Docker or any Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME"

# Secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed CORS origins (frontend URL)
CLIENT_URL=http://localhost:5173

# JWT lifetime
JWT_EXPIRES_IN=7d

# ============ Version 2.0 — AI (Groq, OpenAI-compatible) ============
# Leave GROQ_API_KEY empty to run in offline mode (rule-based prediction only,
# image recognition returns manual entry). NEVER commit a real key.
GROQ_API_KEY=your_groq_api_key_here

# Base URL + models (defaults match Groq)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_VISION_MODEL=llama-3.2-90b-vision-preview
AI_CLASSIFICATION_MODEL=llama-3.3-70b-versatile
# AI request timeout in milliseconds
AI_TIMEOUT_MS=15000

# ============ Version 2.0 — Image uploads (local disk) ============
# Directory (relative to backend/) where uploaded food images are stored
UPLOAD_DIR=uploads
# Max uploaded image size in megabytes
MAX_IMAGE_MB=5

# ============ Version 2.0 — QR codes ============
# How long a donation QR code stays valid (hours)
QR_CODE_TTL_HOURS=168

# ============ Version 2.0 — Scheduled donations ============
# Reminders are sent this many hours before the scheduled pickup
SCHEDULE_REMINDER_HOURS=2
# How often the reminder job polls (milliseconds)
SCHEDULE_REMINDER_INTERVAL_MS=900000

# ============ Testing ============
# Optional: separate test database (used only by the integration test suite)
DATABASE_URL_TEST=
